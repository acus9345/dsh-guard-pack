{
  "name": "dsh-guard-pack",
  "version": "0.1.0",
  "private": true,
  "description": "Nine guard plugins for DeepSeek Harness in one installable set: secret-leak blocking, a per-session cost cap, auto-formatting after edits, plus the six existing dsh-* guards.",
  "license": "MIT",
  "author": "acus9345",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"e2e/*.e2e.ts\"",
    "install-pack": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  },
  "overrides": {
    "@modelcontextprotocol/client": "^2.3.1",
    "fflate": "^0.8.3",
    "zod": "^4.6.6",
    "undici": "^8.12.2",
    "fast-uri": "^3.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/dsh-guard-pack.git"
  },
  "homepage": "https://github.com/acus9345/dsh-guard-pack#readme",
  "bugs": {
    "url": "https://github.com/acus9345/dsh-guard-pack/issues"
  }
}
